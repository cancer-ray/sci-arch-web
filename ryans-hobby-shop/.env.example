# Ryan's Hobby Shop — environment
# Copy to .env and adjust. All values below are safe defaults for the mock rail.

# Which payment rail to use: "mock" (default, zero credentials) or "vopay" (real Interac e-Transfer sandbox)
PAYMENT_PROVIDER=mock

# Port the storefront + API listen on
PORT=3000

# Public origin used to build the webhook callback URL (mock rail calls itself; VoPay calls this too)
PUBLIC_ORIGIN=http://localhost:3000

# Shared secret used to HMAC-sign payment webhooks. The mock rail signs with this and the server
# verifies with it — the exact pattern a real integration uses. Change it for anything non-local.
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Mock rail only: how long (ms) after a Request Money before the simulated "customer approved in
# their banking app" webhook fires. Set high to demo the manual-approve button instead.
MOCK_APPROVAL_DELAY_MS=6000

# --- VoPay sandbox (only needed when PAYMENT_PROVIDER=vopay) ---
# Obtain these after VoPay business onboarding + sandbox provisioning. See README "Going live".
VOPAY_API_BASE=https://earthnode-dev.vopay.com/api/v2
VOPAY_ACCOUNT_ID=
VOPAY_API_KEY=
VOPAY_SHARED_SECRET=
